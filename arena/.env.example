# Copy to .env locally. Set these with Sites runtime environment settings when hosted.
# Current mode: OpenAI-compatible LLM + JEV decision harness.
JEV_BASE_URL=https://llm.sanhouse.kr/v1
JEV_API_STYLE=chat
# Exact model ID from the LLM server.
JEV_MODEL=qwen3.6-35b-a3b
# Existing server-only Bearer key; never put in browser code or Git.
JEV_API_KEY=
# To switch back to an OpenAI-compatible provider, set JEV_BASE_URL,
# JEV_MODEL (exact provider model ID), and JEV_API_STYLE=chat or responses.
PORT=3000
# Optional operator-declared underlying model ID. Leave empty if not known.
# API-reported model_id/model is recorded separately; JEV_MODEL is only a label.
JEV_UPSTREAM_MODEL_ID=
# Optional replay target. Supply a different URL when comparing a new deployment.
# JEV_REPLAY_URL=https://your-comparison-server/v1/decisions

# Native decisions harness shortlist (0=all candidates, default 4).
JEV_CANDIDATE_LIMIT=4
